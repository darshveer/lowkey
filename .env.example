VITE_APP_NAME=LowKey
VITE_APP_ENV=development

# Frontend deployment URL. Used by share links after deployment.
VITE_PUBLIC_APP_URL=https://your-lowkey-domain.example

# Production data layer recommendation: Supabase.
# Add these when replacing src/utils/storage.js localStorage helpers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production payments recommendation: Razorpay Payment Links or Orders.
# Keep secret keys on a serverless backend, never in Vite env.
VITE_RAZORPAY_KEY_ID=

# Optional realtime provider if you choose Firebase instead of Supabase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
