VITE_APP_NAME=LowKey
VITE_APP_ENV=development

# Frontend deployment URL. Used by share links after deployment.
VITE_PUBLIC_APP_URL=https://your-lowkey-domain.example

# Production data layer recommendation: Supabase.
# Use the base project URL (NOT the /rest/v1/ path).
VITE_SUPABASE_URL=
# New-style API keys (anon / service_role are legacy).
# Publishable key (sb_publishable_...) is safe for the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) is SERVER-ONLY — never prefix with VITE_ and never
# ship it to the client. Only used by serverless/backend code, not this SPA.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile CAPTCHA on the login/signup forms (optional).
# This is the PUBLIC site key — browser-safe. Leave blank to disable CAPTCHA
# locally (the widget renders nothing and no token is sent). The matching SECRET
# key goes in the Supabase dashboard (Auth → Settings → Enable CAPTCHA → Turnstile),
# never here. Cloudflare's always-pass test key is 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=


# Optional realtime provider if you choose Firebase instead of Supabase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
